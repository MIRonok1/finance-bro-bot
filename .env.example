# Скопируй в .env и заполни. .env в git не коммитится (см. .gitignore).

# Токен бота от @BotFather. Обязателен.
BOT_TOKEN=

# Telegram user id администраторов через запятую, без пробелов. Обязателен.
# Узнать свой id можно, например, у @userinfobot.
ADMIN_IDS=

# Путь к SQLite. На Netrun не трогать (дефолт /data/bot.db).
# Локально удобно держать рядом с проектом:
DB_PATH=./local.db

# Нужен только для scripts/generate.py и scripts/doctor.py (Веха 4+).
# В рантайме бота не используется и не должен использоваться.
ANTHROPIC_API_KEY=

# Модель для scripts/generate.py. Не обязателен, дефолт claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Пейволл на Telegram Stars (Веха 6): дневной лимит бесплатных сессий и
# /subscribe. Пока держим выключенным.
PAYWALL_ENABLED=false

LOG_LEVEL=INFO

# --- Mini App (Фаза 3) ---
# Публичный HTTPS-адрес Mini App (даёт Netrun после первого деплоя).
# Без него кнопка "🖥 Открыть приложение" в боте не показывается.
WEBAPP_URL=

# Порт aiohttp-сервера Mini App. Локально можно не трогать.
# На Netrun приоритет у PORT, если платформа его сама прокидывает.
WEBAPP_PORT=8080
